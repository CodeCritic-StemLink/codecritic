# The backend and frontend folders each have their own .gitignore for the things
# specific to them. This one covers the repository root only.

# Secrets, wherever they land
.env
.env.*

# Operating system clutter
.DS_Store
Thumbs.db
desktop.ini

# Editors and local tooling
#
# These are per machine settings, not part of the application. One of them,
# .claude/settings.json, was committed once by accident and carried a Windows
# username and a local temp path into the repository with it.
#
# Rules like these had been sitting in .git/info/exclude, which is local to one
# machine and shared with nobody, so everyone else had no protection at all. They
# belong here, where the whole team gets them.
.vscode/
.idea/
*.swp
AGENTS.md
CLAUDE.md
.claude/
.cursor/
.windsurf/
.agents/
skills-lock.json
